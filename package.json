{
  "name": "zerocreds-mcp",
  "version": "0.1.0",
  "description": "MCP server for ZeroCreds — collect credentials from users without exposing them to the LLM",
  "type": "module",
  "bin": {
    "zerocreds-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector dist/index.js"
  },
  "keywords": ["mcp", "credentials", "security", "zerocreds", "llm", "claude"],
  "author": "Zerocreds-com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zerocreds-com/zerocreds-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
